import React, { useEffect, useMemo, useState } from 'react';
import Constants from 'expo-constants';
import axios from 'axios';
import { NavigationContainer, useNavigation } from '@react-navigation/native';
import { createNativeStackNavigator } from '@react-navigation/stack';
import { createBottomTabNavigator } from '@react-navigation/bottom-tabs';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  ScrollView,
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Platform,
} from 'react-native';

const getApiUrl = () => {
  const envUrl = process.env.EXPO_PUBLIC_API_URL?.trim();
  if (envUrl) return envUrl.replace(/\/$/, '');

  const hostUri = Constants.expoConfig?.hostUri || Constants.manifest?.debuggerHost;
  if (hostUri) {
    const host = hostUri.split(':')[0];
    return `http://${host}:4000`;
  }

  return 'http://localhost:4000';
};

const API_URL = getApiUrl();
const api = axios.create({
  baseURL: API_URL,
  timeout: 15000,
});

const Stack = createNativeStackNavigator();
const Tab = createBottomTabNavigator();

type User = {
  id: string;
  name: string;
  email: string;
};

type Wallet = {
  id: string;
  userId: string;
  balance: string | number;
  currency: string;
};

type Transaction = {
  id: string;
  reference: string;
  type: string;
  amount: string | number;
  currency: string;
  status: string;
  description?: string | null;
  createdAt: string;
};

const formatCurrency = (value: number | string) => {
  const numericValue = typeof value === 'number' ? value : Number(value || 0);
  return `₦${numericValue.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
};

function AuthScreen({ navigation }: { navigation: any }) {
  const [email, setEmail] = useState('user@example.com');
  const [password, setPassword] = useState('StrongPassword123!');
  const [loading, setLoading] = useState(false);

  const handleLogin = async () => {
    if (!email || !password) {
      Alert.alert('Missing fields', 'Email and password are required.');
      return;
    }

    try {
      setLoading(true);
      const response = await api.post('/api/auth/login', { email, password });
      const token = response.data.token;
      navigation.navigate('MainApp', { token, user: response.data.user });
    } catch (error: any) {
      const message = error?.response?.data?.error || 'Unable to sign in right now.';
      Alert.alert('Login failed', message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.authContainer}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <ScrollView contentContainerStyle={styles.authContent}>
        <Text style={styles.brand}>CafiPay</Text>
        <Text style={styles.authTitle}>Welcome back</Text>
        <Text style={styles.authSubtitle}>Sign in to continue</Text>

        <TextInput
          style={styles.input}
          placeholder="Email"
          keyboardType="email-address"
          autoCapitalize="none"
          value={email}
          onChangeText={setEmail}
        />

        <TextInput
          style={styles.input}
          placeholder="Password"
          secureTextEntry
          value={password}
          onChangeText={setPassword}
        />

        <TouchableOpacity style={styles.primaryButton} onPress={handleLogin} disabled={loading}>
          {loading ? <ActivityIndicator color="#fff" /> : <Text style={styles.primaryButtonText}>Login</Text>}
        </TouchableOpacity>

        <TouchableOpacity style={styles.secondaryButton} onPress={() => navigation.navigate('Register')}>
          <Text style={styles.secondaryButtonText}>Create account</Text>
        </TouchableOpacity>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

function RegisterScreen({ navigation }: { navigation: any }) {
  const [name, setName] = useState('Demo User');
  const [email, setEmail] = useState('user@example.com');
  const [password, setPassword] = useState('StrongPassword123!');
  const [loading, setLoading] = useState(false);

  const handleRegister = async () => {
    if (!name || !email || !password) {
      Alert.alert('Missing fields', 'Please complete all fields.');
      return;
    }

    try {
      setLoading(true);
      const response = await api.post('/api/auth/register', { name, email, password });
      const token = response.data.token;
      navigation.replace('MainApp', { token, user: response.data.user });
    } catch (error: any) {
      const message = error?.response?.data?.error || 'Unable to register right now.';
      Alert.alert('Registration failed', message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <KeyboardAvoidingView
      style={styles.authContainer}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <ScrollView contentContainerStyle={styles.authContent}>
        <Text style={styles.brand}>CafiPay</Text>
        <Text style={styles.authTitle}>Create account</Text>

        <TextInput style={styles.input} placeholder="Full name" value={name} onChangeText={setName} />
        <TextInput
          style={styles.input}
          placeholder="Email"
          keyboardType="email-address"
          autoCapitalize="none"
          value={email}
          onChangeText={setEmail}
        />
        <TextInput
          style={styles.input}
          placeholder="Password"
          secureTextEntry
          value={password}
          onChangeText={setPassword}
        />

        <TouchableOpacity style={styles.primaryButton} onPress={handleRegister} disabled={loading}>
          {loading ? <ActivityIndicator color="#fff" /> : <Text style={styles.primaryButtonText}>Sign up</Text>}
        </TouchableOpacity>

        <TouchableOpacity style={styles.secondaryButton} onPress={() => navigation.goBack()}>
          <Text style={styles.secondaryButtonText}>Back to login</Text>
        </TouchableOpacity>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

function TransferScreen({ route, navigation }: { route: any; navigation: any }) {
  const { token, currentBalance, onTransferComplete } = route.params || {};
  const [recipient, setRecipient] = useState('Aisha Bello');
  const [amount, setAmount] = useState('5000');
  const [note, setNote] = useState('Dinner split');
  const [loading, setLoading] = useState(false);

  const handleTransfer = () => {
    const numericAmount = Number(amount);

    if (!recipient.trim()) {
      Alert.alert('Missing recipient', 'Please add a recipient name or account.');
      return;
    }

    if (!numericAmount || numericAmount <= 0) {
      Alert.alert('Invalid amount', 'Enter a valid transfer amount.');
      return;
    }

    if (numericAmount > Number(currentBalance || 0)) {
      Alert.alert('Insufficient balance', 'The transfer amount exceeds your available balance.');
      return;
    }

    setLoading(true);

    setTimeout(() => {
      onTransferComplete?.({
        amount: numericAmount,
        description: note || `Transfer to ${recipient}`,
      });
      setLoading(false);
      navigation.goBack();
      Alert.alert('Transfer successful', `₦${numericAmount.toLocaleString()} was sent to ${recipient}.`);
    }, 500);
  };

  return (
    <KeyboardAvoidingView
      style={styles.authContainer}
      behavior={Platform.OS === 'ios' ? 'padding' : undefined}
    >
      <ScrollView contentContainerStyle={styles.transferContent}>
        <Text style={styles.transferHeader}>Send money</Text>
        <Text style={styles.transferBalance}>Available: {formatCurrency(currentBalance || 0)}</Text>

        <TextInput
          style={styles.input}
          placeholder="Recipient name"
          value={recipient}
          onChangeText={setRecipient}
        />

        <TextInput
          style={styles.input}
          placeholder="Amount"
          keyboardType="numeric"
          value={amount}
          onChangeText={setAmount}
        />

        <TextInput
          style={[styles.input, styles.textArea]}
          placeholder="Note (optional)"
          multiline
          value={note}
          onChangeText={setNote}
        />

        <TouchableOpacity style={styles.primaryButton} onPress={handleTransfer} disabled={loading}>
          {loading ? <ActivityIndicator color="#fff" /> : <Text style={styles.primaryButtonText}>Send</Text>}
        </TouchableOpacity>

        <TouchableOpacity style={styles.secondaryButton} onPress={() => navigation.goBack()}>
          <Text style={styles.secondaryButtonText}>Cancel</Text>
        </TouchableOpacity>
      </ScrollView>
    </KeyboardAvoidingView>
  );
}

function HomeScreen({ token, user }: { token: string; user: User | null }) {
  const navigation = useNavigation<any>();
  const [balance, setBalance] = useState<string>('125500.00');
  const [transactions, setTransactions] = useState<Transaction[]>([
    {
      id: 'txn-1',
      reference: 'TRF-1001',
      type: 'TRANSFER',
      amount: '2500',
      currency: 'NGN',
      status: 'SUCCESS',
      description: 'Transfer to Aisha Bello',
      createdAt: new Date().toISOString(),
    },
    {
      id: 'txn-2',
      reference: 'AIRTIME-2001',
      type: 'AIRTIME',
      amount: '1800',
      currency: 'NGN',
      status: 'SUCCESS',
      description: 'Airtime recharge',
      createdAt: new Date().toISOString(),
    },
  ]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchHomeData = async () => {
      try {
        const walletResponse = await api.get('/api/wallet', {
          headers: { Authorization: `Bearer ${token}` },
        });

        const txResponse = await api.get('/api/transactions', {
          headers: { Authorization: `Bearer ${token}` },
        });

        setBalance(String(walletResponse.data.wallet?.balance ?? '125500.00'));
        setTransactions(txResponse.data.transactions || transactions);
      } catch (error) {
        console.warn('Home data fetch failed', error);
      } finally {
        setLoading(false);
      }
    };

    fetchHomeData();
  }, [token]);

  const handleTransferComplete = ({ amount, description }: { amount: number; description: string }) => {
    setBalance((previous) => {
      const next = Number(previous || 0) - amount;
      return String(Math.max(next, 0).toFixed(2));
    });

    setTransactions((previous) => [
      {
        id: `txn-${Date.now()}`,
        reference: `TRF-${Date.now()}`,
        type: 'TRANSFER',
        amount: String(amount),
        currency: 'NGN',
        status: 'SUCCESS',
        description,
        createdAt: new Date().toISOString(),
      },
      ...previous,
    ]);
  };

  return (
    <ScrollView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}>CafiPay</Text>
        <Text style={styles.subtitle}>Available Balance</Text>
        <Text style={styles.balance}>{loading ? 'Loading...' : formatCurrency(balance)}</Text>
        <Text style={styles.welcomeText}>Hi, {user?.name || 'there'}!</Text>
      </View>

      <View style={styles.quickActions}>
        <TouchableOpacity
          style={styles.actionButton}
          onPress={() => navigation.navigate('Transfer', {
            token,
            currentBalance: balance,
            onTransferComplete: handleTransferComplete,
          })}
        >
          <Text style={styles.actionText}>Send</Text>
        </TouchableOpacity>
        <TouchableOpacity style={styles.actionButton}><Text style={styles.actionText}>Receive</Text></TouchableOpacity>
        <TouchableOpacity style={styles.actionButton}><Text style={styles.actionText}>Scan QR</Text></TouchableOpacity>
        <TouchableOpacity style={styles.actionButton}><Text style={styles.actionText}>Pay</Text></TouchableOpacity>
      </View>

      <View style={styles.section}>
        <Text style={styles.sectionTitle}>Quick Services</Text>
        <View style={styles.serviceGrid}>
          <TouchableOpacity style={styles.serviceButton}><Text style={styles.serviceText}>Airtime</Text></TouchableOpacity>
          <TouchableOpacity style={styles.serviceButton}><Text style={styles.serviceText}>Data</Text></TouchableOpacity>
          <TouchableOpacity style={styles.serviceButton}><Text style={styles.serviceText}>Bills</Text></TouchableOpacity>
          <TouchableOpacity style={styles.serviceButton}><Text style={styles.serviceText}>International</Text></TouchableOpacity>
        </View>
      </View>

      <View style={styles.section}>
        <Text style={styles.sectionTitle}>Exchange Rates</Text>
        <View style={styles.rateContainer}>
          <Text style={styles.rateText}>USD/NGN: 1,520.00</Text>
          <Text style={styles.rateText}>GBP/NGN: 1,920.00</Text>
          <Text style={styles.rateText}>EUR/NGN: 1,650.00</Text>
        </View>
      </View>

      <View style={styles.section}>
        <Text style={styles.sectionTitle}>Recent Activity</Text>
        {loading ? (
          <ActivityIndicator color="#1E90FF" />
        ) : transactions.length === 0 ? (
          <View style={styles.emptyStateSmall}><Text style={styles.emptyText}>No recent activity</Text></View>
        ) : (
          transactions.slice(0, 3).map((item) => (
            <View key={item.id} style={styles.transactionItem}>
              <View>
                <Text style={styles.transactionType}>{item.type}</Text>
                <Text style={styles.transactionMeta}>{item.description || item.reference}</Text>
              </View>
              <Text style={styles.transactionAmount}>{formatCurrency(item.amount)}</Text>
            </View>
          ))
        )}
      </View>
    </ScrollView>
  );
}

function WalletScreen({ token }: { token: string }) {
  const [wallet, setWallet] = useState<Wallet | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchWallet = async () => {
      try {
        const response = await api.get('/api/wallet', {
          headers: { Authorization: `Bearer ${token}` },
        });
        setWallet(response.data.wallet);
      } catch (error) {
        console.warn('Wallet fetch failed', error);
        setWallet(null);
      } finally {
        setLoading(false);
      }
    };

    fetchWallet();
  }, [token]);

  return (
    <View style={styles.container}>
      <View style={styles.sectionHeaderBox}>
        <Text style={styles.sectionTitle}>Wallet & History</Text>
      </View>
      {loading ? (
        <View style={styles.emptyState}><ActivityIndicator color="#1E90FF" /></View>
      ) : wallet ? (
        <View style={styles.walletCard}>
          <Text style={styles.walletLabel}>Available balance</Text>
          <Text style={styles.walletBalance}>{formatCurrency(wallet.balance)}</Text>
          <Text style={styles.walletCurrency}>{wallet.currency}</Text>
        </View>
      ) : (
        <View style={styles.emptyState}><Text style={styles.emptyText}>No wallet data available</Text></View>
      )}
    </View>
  );
}

function HistoryScreen({ token }: { token: string }) {
  const [transactions, setTransactions] = useState<Transaction[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchTransactions = async () => {
      try {
        const response = await api.get('/api/transactions', {
          headers: { Authorization: `Bearer ${token}` },
        });
        setTransactions(response.data.transactions || []);
      } catch (error) {
        console.warn('Transaction fetch failed', error);
        setTransactions([]);
      } finally {
        setLoading(false);
      }
    };

    fetchTransactions();
  }, [token]);

  return (
    <View style={styles.container}>
      <View style={styles.sectionHeaderBox}>
        <Text style={styles.sectionTitle}>Transaction History</Text>
      </View>
      {loading ? (
        <View style={styles.emptyState}><ActivityIndicator color="#1E90FF" /></View>
      ) : transactions.length === 0 ? (
        <View style={styles.emptyState}><Text style={styles.emptyText}>No transaction history</Text></View>
      ) : (
        <ScrollView contentContainerStyle={styles.listContainer}>
          {transactions.map((item) => (
            <View key={item.id} style={styles.transactionRow}>
              <View>
                <Text style={styles.transactionType}>{item.type}</Text>
                <Text style={styles.transactionMeta}>{item.description || item.reference}</Text>
              </View>
              <Text style={styles.transactionAmount}>{formatCurrency(item.amount)}</Text>
            </View>
          ))}
        </ScrollView>
      )}
    </View>
  );
}

function ProfileScreen({ user, token, onLogout }: { user: User | null; token: string; onLogout: () => void }) {
  const fullUser = useMemo(
    () => ({
      name: user?.name || 'Demo User',
      email: user?.email || 'demo@cafipay.com',
      phone: '+234XXXXXXXXXX',
    }),
    [user]
  );

  return (
    <ScrollView style={styles.container}>
      <View style={styles.profileHeader}>
        <View style={styles.avatar}><Text style={styles.avatarText}>{fullUser.name.substring(0, 2).toUpperCase()}</Text></View>
        <Text style={styles.profileName}>{fullUser.name}</Text>
        <Text style={styles.profileDetail}>{fullUser.email}</Text>
        <Text style={styles.profileDetail}>{fullUser.phone}</Text>
      </View>

      <View style={styles.section}>
        <TouchableOpacity style={styles.profileOption}><Text style={styles.profileOptionText}>Account Settings</Text></TouchableOpacity>
        <TouchableOpacity style={styles.profileOption}><Text style={styles.profileOptionText}>Security</Text></TouchableOpacity>
        <TouchableOpacity style={styles.profileOption}><Text style={styles.profileOptionText}>Beneficiaries</Text></TouchableOpacity>
        <TouchableOpacity style={styles.profileOption}><Text style={styles.profileOptionText}>Help & Support</Text></TouchableOpacity>
        <TouchableOpacity
          style={[styles.profileOption, styles.logoutButton]}
          onPress={async () => {
            try {
              await api.post('/api/auth/logout', {}, { headers: { Authorization: `Bearer ${token}` } });
            } catch (_error) {
              // ignore server-side logout failure for demo flows and still log out locally
            }
            onLogout();
          }}
        >
          <Text style={styles.logoutText}>Logout</Text>
        </TouchableOpacity>
      </View>
    </ScrollView>
  );
}

function TabNavigator({ token, user, onLogout }: { token: string; user: User | null; onLogout: () => void }) {
  return (
    <Tab.Navigator
      screenOptions={{
        headerShown: false,
        tabBarActiveTintColor: '#1E90FF',
        tabBarInactiveTintColor: '#999',
        tabBarStyle: styles.tabBar,
      }}
    >
      <Tab.Screen name="Home" options={{ tabBarLabel: 'Home' }}>
        {() => <HomeScreen token={token} user={user} />}
      </Tab.Screen>
      <Tab.Screen name="Wallet" options={{ tabBarLabel: 'Wallet' }}>
        {() => <WalletScreen token={token} />}
      </Tab.Screen>
      <Tab.Screen name="History" options={{ tabBarLabel: 'History' }}>
        {() => <HistoryScreen token={token} />}
      </Tab.Screen>
      <Tab.Screen name="Profile" options={{ tabBarLabel: 'Profile' }}>
        {() => <ProfileScreen user={user} token={token} onLogout={onLogout} />}
      </Tab.Screen>
    </Tab.Navigator>
  );
}

export default function App() {
  const [token, setToken] = useState<string | null>(null);
  const [user, setUser] = useState<User | null>(null);

  const handleAuthSuccess = (newToken: string, newUser: User) => {
    setToken(newToken);
    setUser(newUser);
  };

  const handleLogout = () => {
    setToken(null);
    setUser(null);
  };

  return (
    <NavigationContainer>
      <Stack.Navigator screenOptions={{ headerShown: false }}>
        {!token ? (
          <>
            <Stack.Screen name="Auth">
              {(props: any) => <AuthScreen {...props} />}
            </Stack.Screen>
            <Stack.Screen name="Register">
              {(props: any) => <RegisterScreen {...props} />}
            </Stack.Screen>
          </>
        ) : (
          <>
            <Stack.Screen name="MainApp">
              {() => <TabNavigator token={token} user={user} onLogout={handleLogout} />}
            </Stack.Screen>
            <Stack.Screen name="Transfer" component={TransferScreen} />
          </>
        )}
      </Stack.Navigator>
    </NavigationContainer>
  );
}

